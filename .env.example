# ─── PasteBin Enterprise Environment Configuration ───
PORT=5000
NODE_ENV=development

# 1. OpenRouter API (Code Explanation, Optimization, Summarization, Tag Generation)
OPENROUTER_API_KEY=your_openrouter_key_here

# 2. Hugging Face API (Code Classification, Language Detection, Categorization)
HUGGINGFACE_API_KEY=your_huggingface_key_here

# 3. Supabase Integration (PostgreSQL Database & Auth - Service Role on Backend Only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 4. Cloudflare Turnstile (Bot & Anti-Spam Protection)
TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# 5. Cloudflare R2 Object Storage (S3-Compatible Attachments & Backup Exports)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=pastebin-attachments
