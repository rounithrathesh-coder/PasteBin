# Local open-source development: no cloud API keys required.
PORT=5000
NODE_ENV=development
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional: direct local MinIO access (Docker Compose injects these automatically).
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=pastebin-local
R2_SECRET_ACCESS_KEY=pastebin-local-password
R2_BUCKET_NAME=pastebin-attachments
